---
import Base from '../layouts/Base.astro';
import Figure from './Figure.astro';
import { UI, href, type Lang } from '../i18n';
import { MATCHES, type Match } from '../data/projects';

interface Props { lang: Lang; match: Match }
const { lang, match: m } = Astro.props;

const next = MATCHES[(MATCHES.indexOf(m) + 1) % MATCHES.length];
const vs = lang === 'en' ? 'vs' : '对';
---

<Base lang={lang} title={`${m.title[lang]} — Allen Huang`} description={m.line[lang]} path={`${m.slug}/`}>
  <section class="scoreboard">
    <div class="wrap">
      <div class="sb-top mono">
        <a href={`${href(lang)}#matches`}>← {UI.back[lang]}</a>
        <span class={`status ${m.status}`}>{m.statusLabel[lang]}</span>
      </div>
      <div class="sb-line" aria-label={`${m.home.name[lang]} ${vs} ${m.away.name[lang]}`}>
        <div class="sb-side home"><strong class:list={{ zh: m.home.zh, long: m.home.name[lang].length > 6 }}>{m.home.name[lang]}</strong><span>{m.home.note[lang]}</span></div>
        <div class:list={['sb-score', { live: m.status === 'live' }]}><strong>{m.score.value[lang]}</strong><span>{m.score.label[lang]}</span></div>
        <div class="sb-side away"><strong class:list={{ zh: m.away.zh, long: m.away.name[lang].length > 6 }}>{m.away.name[lang]}</strong><span>{m.away.note[lang]}</span></div>
      </div>
      <div class="sb-title">
        <div>
          <p class="mono" style="margin: 0 0 6px; color: var(--board-muted)">{UI.report[lang]} · {m.dates[lang]}</p>
          <h1>{m.title[lang]}</h1>
          <p>{m.line[lang]}</p>
        </div>
        <dl class="sb-meta">
          <div><dt>{UI.role[lang]}</dt><dd>{m.role[lang]}</dd></div>
          <div><dt>{UI.built[lang]}</dt><dd>{m.stack}</dd></div>
          <div><dt>{UI.links[lang]}</dt><dd>{m.links.length ? m.links.map((l) => <a href={l.url} target="_blank" rel="noreferrer">{l.label[lang]} ↗</a>) : UI.privateRepo[lang]}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  {m.blocks.map((b) => (
    <section class="block">
      <div class="wrap">
        <div class="block-head">
          <p class="tag mono">{b.tag[lang]}</p>
          <div class="block-body">
            <h2 class="display display-zh">{b.heading[lang]}</h2>
            {b.kind === 'text' && <div class="prose">{b.body.map((p) => <p set:html={p[lang]} />)}</div>}
            {b.kind === 'figure' && b.body && <div class="prose">{b.body.map((p) => <p set:html={p[lang]} />)}</div>}
            {b.kind === 'rules' && b.intro && <div class="prose"><p>{b.intro[lang]}</p></div>}
            {b.kind === 'log' && b.intro && <div class="prose"><p>{b.intro[lang]}</p></div>}
          </div>
        </div>
        {b.kind === 'rules' && (
          <div class="rules" style={`--cols: ${b.rules.length % 3 === 0 ? 3 : b.rules.length % 4 === 0 ? 4 : 2}`}>
            {b.rules.map((r, i) => (
              <article class="rule">
                <span class="rn">{lang === 'en' ? `R${i + 1}` : `第${i + 1}条`}</span>
                <h3>{r.title[lang]}</h3>
                <p set:html={r.body[lang]} />
              </article>
            ))}
          </div>
        )}
        {b.kind === 'log' && (
          <ol class="log">
            {b.entries.map((e) => (
              <li class:list={{ key: e.key }}>
                <time>{e.date === 'Now' ? (lang === 'en' ? 'Now' : '现在') : e.date}</time>
                <div>
                  <h3>{e.key && <span class="kp">{lang === 'en' ? 'Key play' : '关键回合'}</span>}{e.title[lang]}</h3>
                  {e.body && <p set:html={e.body[lang]} />}
                </div>
              </li>
            ))}
          </ol>
        )}
        {(b.kind === 'figure' || (b.kind === 'text' && b.figure)) && (
          <div class="block-wide"><Figure id={b.kind === 'figure' ? b.figure : b.figure!} lang={lang} /></div>
        )}
      </div>
    </section>
  ))}

  <div class="wrap" style="border-top: 3px solid var(--ink)">
    <a class="next" href={href(lang, `${next.slug}/`)}>
      <span><small class="mono">{UI.next[lang]}</small><strong>{next.home.name[lang]} {vs} {next.away.name[lang]}</strong></span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>
</Base>
