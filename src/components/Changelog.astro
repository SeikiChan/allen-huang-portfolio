---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { UI, href, type Lang } from '../i18n';
import { ENTRIES, VERDICT, type Entry } from '../data/changelog';

interface Props { lang: Lang }
const { lang } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/changelog/*.webp', { eager: true });
const byName = Object.fromEntries(Object.entries(files).map(([p, m]) => [p.split('/').pop()!.replace('.webp', ''), m.default]));
/** Language-specific screenshot when there is one, otherwise the shared one. */
const shot = (name: string) => byName[`${name}-${lang}`] ?? byName[name];
/** Show a screenshot no larger than it was captured; the progress-line crops were taken at 2x. */
const cap = (name: string) => `max-width: ${shot(name).width / (name.includes('progress') ? 2 : 1)}px`;

const when = (iso: string) => {
  if (!iso) return lang === 'en' ? 'Not committed' : '未提交';
  const d = new Date(iso.replace('Z', ':00Z'));
  const hm = `${String(d.getUTCHours()).padStart(2, '0')}:${String(d.getUTCMinutes()).padStart(2, '0')} UTC`;
  return lang === 'en' ? `Oct ${d.getUTCDate()}, ${hm}` : `10 月 ${d.getUTCDate()} 日 ${hm}`;
};
const id = (e: Entry) => `v-${e.v.replace(/[^a-z0-9]+/gi, '').toLowerCase()}`;
const rejected = ENTRIES.filter((e) => e.verdict === 'rejected').length;

const t = lang === 'en'
  ? {
      title: 'Changelog — Allen Huang',
      desc: 'Every version of this site was generated by an AI coding agent. What I rejected, why, and what replaced it.',
      eyebrow: 'Changelog',
      h1: 'How I reviewed this site into shape',
      lead: 'Every version of this site was generated by an AI coding agent. I reviewed each one against my own eye for layout, type and reading, rejected most of them, and said why. This page keeps the versions and my notes, oldest first.',
      stats: [[String(ENTRIES.length), 'rounds of review'], [String(rejected), 'versions rejected outright'], ['1', 'day']],
      proposed: 'AI proposed', review: 'My review', decision: 'Decision', before: 'AI version', after: 'After my review',
      now: 'Now', nowText: 'The current site. Every rule above still applies to the next change.', open: 'Open the site',
    }
  : {
      title: '更新日志 — Allen Huang',
      desc: '这个网站的每一版都由 AI 编程助手生成。我否决了什么、为什么、换成了什么。',
      eyebrow: '更新日志',
      h1: '这个网站是怎么被我审出来的',
      lead: '这个网站的每一版都由 AI 编程助手生成。我用自己对版式、字体和阅读的判断逐版审查，否掉了大部分，并写明理由。这里按时间顺序保留每一版和我的审查记录。',
      stats: [[String(ENTRIES.length), '轮审查'], [String(rejected), '版被整体否决'], ['1', '天']],
      proposed: 'AI 方案', review: '我的审查', decision: '决定', before: 'AI 版本', after: '审查之后',
      now: '现在', nowText: '当前的网站。上面的每一条规则，下一次修改仍然适用。', open: '打开网站',
    };
---

<Base lang={lang} title={t.title} description={t.desc} path="changelog/">
  <section class="p-hero cl-hero">
    <div class="wrap">
      <a class="p-back" href={href(lang)}>← {lang === 'en' ? 'Home' : '首页'}</a>
      <p class="eyebrow cl-eyebrow">{t.eyebrow}</p>
      <h1 class="grad">{t.h1}</h1>
      <p class="p-lead">{t.lead}</p>
      <dl class="cl-stats">
        {t.stats.map(([n, l]) => <div><dt>{n}</dt><dd>{l}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="cl" data-sec="log">
    <div class="wrap">
      <ol class="cl-list">
        {ENTRIES.map((e) => (
          <li class="cl-entry" id={id(e)} data-cp={e.v}>
            <div class="cl-meta">
              <span class="cl-v">{e.v}</span>
              <time datetime={e.when || undefined}>{when(e.when)}</time>
              <span class={`verdict ${e.verdict}`}>{VERDICT[e.verdict][lang]}</span>
            </div>
            <div class="cl-body">
              <h2>{e.title[lang]}</h2>
              <p class="cl-line"><span>{t.proposed}</span>{e.proposed[lang]}</p>

              {e.shots && (
                <div class:list={['cl-shots', `n${Math.min(e.shots.length, 3)}`, { stack: e.shots.some((s) => shot(s.img).width / shot(s.img).height > 3) }]}>
                  {e.shots.map((s) => (
                    <figure>
                      <a class="frame" href={shot(s.img).src} target="_blank" rel="noopener" style={cap(s.img)}>
                        <Image src={shot(s.img)} alt={s.cap[lang]} widths={[480, 960, 1440]} sizes="(max-width: 900px) 92vw, 760px" />
                      </a>
                      <figcaption>{s.cap[lang]}</figcaption>
                    </figure>
                  ))}
                </div>
              )}

              {e.pairs && e.pairs.map((p) => {
                const a = shot(p.before), b = shot(p.after);
                const stack = a.width / a.height > 1.6;
                return (
                  <figure class:list={['cl-pair', { stack }]}>
                    <div class="pair-row">
                      <div><span class="tag before">{t.before}</span><a class="frame" href={a.src} target="_blank" rel="noopener" style={cap(p.before)}><Image src={a} alt={`${t.before}: ${p.cap[lang]}`} widths={[480, 960, 1440]} sizes="(max-width: 900px) 92vw, 760px" /></a></div>
                      <div><span class="tag after">{t.after}</span><a class="frame" href={b.src} target="_blank" rel="noopener" style={cap(p.after)}><Image src={b} alt={`${t.after}: ${p.cap[lang]}`} widths={[480, 960, 1440]} sizes="(max-width: 900px) 92vw, 760px" /></a></div>
                    </div>
                    <figcaption>{p.cap[lang]}</figcaption>
                  </figure>
                );
              })}

              <div class="cl-review">
                <p class="cl-label">{t.review}</p>
                <ul>{e.review.map((r) => <li>{r[lang]}</li>)}</ul>
              </div>
              <p class="cl-line cl-decision"><span>{t.decision}</span>{e.decision[lang]}</p>
            </div>
          </li>
        ))}
        <li class="cl-entry now" data-cp={t.now}>
          <div class="cl-meta"><span class="cl-v">{t.now}</span></div>
          <div class="cl-body">
            <p class="cl-now">{t.nowText}</p>
            <div class="cl-shots n1">
              <figure><a class="frame" href={href(lang)}><Image src={shot('now-home')} alt={t.now} widths={[480, 960, 1440]} sizes="(max-width: 900px) 92vw, 760px" /></a></figure>
            </div>
            <a class="btn btn-ghost" href={href(lang)}>{t.open} <span class="arr" aria-hidden="true">→</span></a>
          </div>
        </li>
      </ol>
    </div>
  </section>
</Base>

<style>
  .cl-hero { padding-bottom: clamp(40px, 5vw, 64px); }
  .cl-eyebrow { position: relative; margin-top: 22px; }
  .cl-hero h1 { margin-top: 12px; max-width: 16ch; }
  .cl-stats { position: relative; display: flex; flex-wrap: wrap; gap: 12px 48px; margin: clamp(28px, 4vw, 40px) 0 0; padding-top: 22px; border-top: 1px solid var(--line); }
  .cl-stats dt { font-size: clamp(1.8rem, 3.4vw, 2.6rem); font-weight: 600; letter-spacing: -0.04em; line-height: 1; font-variant-numeric: tabular-nums; }
  .cl-stats dd { margin: 6px 0 0; font-size: 14px; color: var(--muted); }

  .cl { padding-bottom: clamp(64px, 8vw, 110px); }
  .cl-list { list-style: none; margin: 0; padding: 0; }
  .cl-entry { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 0 clamp(24px, 4vw, 56px); padding: clamp(40px, 5vw, 64px) 0; border-top: 1px solid var(--line); }
  .cl-meta { position: sticky; top: 32px; align-self: start; display: grid; gap: 8px; justify-items: start; }
  .cl-v { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 600; letter-spacing: -0.04em; line-height: 1; }
  .cl-meta time { font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .verdict { display: inline-flex; align-items: center; gap: 7px; height: 26px; padding: 0 10px; border-radius: 999px; font-size: 13px; font-weight: 500; }
  .verdict::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .verdict.rejected { color: #ff8a80; background: rgba(184, 35, 26, 0.18); }
  .verdict.mixed { color: #ffc27a; background: rgba(255, 170, 60, 0.12); }
  .verdict.chosen, .verdict.kept { color: var(--green); background: rgba(143, 211, 178, 0.12); }
  .verdict.fixed { color: #b9c6ff; background: rgba(125, 149, 255, 0.16); }

  .cl-body { min-width: 0; max-width: 820px; display: grid; gap: 22px; align-content: start; }
  .cl-body h2 { font-size: clamp(1.6rem, 3vw, 2.3rem); line-height: 1.1; }
  .cl-line { color: var(--text-2); max-width: 44em; }
  .cl-line span, .cl-label { display: block; font-size: 13px; font-weight: 500; color: var(--accent); margin-bottom: 4px; }
  .cl-line.cl-decision { color: var(--text); }

  .cl-shots { display: grid; gap: 14px; }
  .cl-shots.n2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .cl-shots.n3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .cl-shots.stack { grid-template-columns: 1fr; }
  .frame { display: block; border-radius: 10px; overflow: hidden; border: 1px solid var(--line-2); background: var(--panel); transition: border-color 0.2s; }
  .frame:hover { border-color: rgba(125, 149, 255, 0.6); }
  .frame img { display: block; width: 100%; height: auto; }
  figure { margin: 0; }
  figcaption { margin-top: 8px; font-size: 13px; color: var(--muted); }

  .cl-pair .pair-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; align-items: start; }
  .cl-pair.stack .pair-row { grid-template-columns: 1fr; }
  .cl-pair .tag { display: inline-block; font-size: 12px; font-weight: 500; margin-bottom: 6px; }
  .tag.before { color: var(--muted); }
  .tag.after { color: var(--green); }

  .cl-review { padding: 16px 20px 18px; border-left: 2px solid var(--accent); background: rgba(125, 149, 255, 0.06); border-radius: 0 10px 10px 0; }
  .cl-review ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .cl-review li { position: relative; padding-left: 16px; color: var(--text); font-size: 15.5px; line-height: 1.55; }
  .cl-review li::before { content: ''; position: absolute; left: 0; top: 0.7em; width: 6px; height: 1.5px; background: var(--accent); }

  .now .cl-v { color: var(--green); }
  .cl-now { color: var(--text-2); }
  .now .btn { justify-self: start; }

  @media (max-width: 900px) {
    .cl-entry { grid-template-columns: 1fr; gap: 16px; }
    .cl-meta { position: static; grid-auto-flow: column; align-items: center; justify-content: start; gap: 12px; }
    .cl-shots.n3 { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .cl-shots.n2, .cl-shots.n3, .cl-pair .pair-row { grid-template-columns: 1fr; }
  }
</style>
