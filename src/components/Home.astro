---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { CONTACT, UI, href, type Lang } from '../i18n';
import { MATCHES } from '../data/projects';
import title from '../assets/debt-runner/title.webp';
import gameplay from '../assets/debt-runner/gameplay.webp';
import levelUp from '../assets/debt-runner/level-up.webp';
import shop from '../assets/debt-runner/shop.webp';
import radarEn from '../assets/news-radar/dashboard-en.png';
import radarZh from '../assets/news-radar/dashboard-zh.png';

interface Props { lang: Lang }
const { lang } = Astro.props;

const c = {
  en: {
    title: 'Allen Huang — AI tools and games',
    desc: 'Allen Huang builds AI tools and games: Claude vs GPT trading, a model evaluation, a live stock model, a research terminal, and a Unity roguelite.',
    kicker: ['Portfolio', '2026'],
    role: 'AI evaluation & tools · Game production & QA',
    intro: 'I design experiments that test AI models, build research tools around them, and run my own trading model live. On the game side I lead small teams: DebtRunner went from first commit to a playable build in four weeks and was selected for the AAU Spring Show.',
    ribbon: [
      ['live', 'Running', 'AI Portfolio Arena', 'Claude vs GPT'],
      ['', 'Done', 'Model evaluation', 'GPT 13–4 Claude'],
      ['live', 'Live', 'AM 70/30', 'weekly stock model'],
      ['', 'v1.0', 'AI News Radar', 'released'],
      ['', 'Spring Show', 'DebtRunner', '4 people · 4 weeks'],
    ],
    mHead: 'Selected work',
    mP: 'Four AI projects and one game. Each page shows the rules, the timeline and what I changed along the way.',
    open: 'Read more',
    hHead: 'Highlights',
    hP: 'Real screens from DebtRunner and AI News Radar.',
    caps: ['DebtRunner · title screen', 'Round 1', 'Level up', 'Shop and wheel', 'AI News Radar · daily brief'],
    pHead: 'About',
    pLead: 'I work in two areas: AI tools and games. Claude Code and Codex write most of the code in these projects. My part is deciding what to build, writing the rules, checking what comes back, and choosing what ships.',
    card: [
      ['Positions', 'AI evaluation & tooling · Game production & QA'],
      ['Languages', 'Mandarin (native) · Cantonese (native) · English (professional)'],
      ['School', 'Academy of Art University'],
      ['Tools', 'Claude Code · Codex · Python · Unity 6 · C#'],
      ['Looking for', 'AI evaluation, AI tooling, game production, game QA / Simplified Chinese LQA'],
    ],
    cHead: 'Get in touch',
    cP: 'Email is the fastest way to reach me.',
  },
  zh: {
    title: 'Allen Huang — AI 工具与游戏',
    desc: 'Allen Huang 做 AI 工具和游戏：Claude 对 GPT 炒股、模型评估、实盘选股模型、研究终端，以及一款 Unity roguelite。',
    kicker: ['作品集', '2026'],
    role: 'AI 评估与工具 · 游戏制作与 QA',
    intro: '我设计检验 AI 模型的实验，围绕它们做研究工具，也在实盘运行自己的量化模型。游戏方面，我带小团队做项目：DebtRunner 从第一次提交到可玩版本只用了四周，并入选 AAU 春季作品展。',
    ribbon: [
      ['live', '运行中', 'AI 角斗场', 'Claude 对 GPT'],
      ['', '已完成', '模型评估', 'GPT 13–4 Claude'],
      ['live', '实盘', 'AM 70/30', '周度选股模型'],
      ['', 'v1.0', 'AI News Radar', '已发布'],
      ['', '春季展', 'DebtRunner', '4 人 · 4 周'],
    ],
    mHead: '项目',
    mP: '四个 AI 项目和一款游戏。每个项目页都写了规则、时间线，以及过程中我改了什么。',
    open: '查看详情',
    hHead: '精彩镜头',
    hP: 'DebtRunner 和 AI News Radar 的真实画面。',
    caps: ['DebtRunner · 标题画面', '第一回合', '升级选卡', '商店与转盘', 'AI News Radar · 每日简报'],
    pHead: '关于我',
    pLead: '我做两个方向：AI 工具和游戏。这些项目里的大部分代码由 Claude Code 和 Codex 编写。我负责的是：决定做什么、定规则、检查交回来的结果、决定什么能上线。',
    card: [
      ['位置', 'AI 评估与工具 · 游戏制作与 QA'],
      ['语言', '普通话（母语）· 粤语（母语）· 英语（工作语言）'],
      ['学校', 'Academy of Art University'],
      ['工具', 'Claude Code · Codex · Python · Unity 6 · C#'],
      ['在找', 'AI 评估、AI 工具、游戏制作、游戏 QA / 简体中文 LQA 方向的工作'],
    ],
    cHead: '联系我',
    cP: '发邮件最快。',
  },
}[lang];
const radar = lang === 'en' ? radarEn : radarZh;
const shots = [title, gameplay, levelUp, shop, radar];
---

<Base lang={lang} title={c.title} description={c.desc} path="">
  <section class="masthead">
    <div class="wrap">
      <div class="mast-top mono"><span>{c.kicker[0]}</span><span>{c.kicker[1]}</span></div>
      <h1 class="name">Allen <span class="v">Huang</span></h1>
      <p class="role-line display display-zh">{c.role}</p>
      <div class="mast-grid">
        <p class="intro">{c.intro}</p>
        <div class="mast-links">
          <a class="btn" href="#work">{c.mHead} ↓</a>
          <a class="btn ghost" href={`mailto:${CONTACT.email}`}>{UI.email[lang]}</a>
          <a class="btn ghost" href={CONTACT.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
        </div>
      </div>
    </div>
  </section>

  <div class="ribbon" aria-label={lang === 'en' ? 'Scores' : '比分'}>
    <div class="ribbon-track">
      {[0, 1].map((n) => (
        <div class="ribbon-set" aria-hidden={n === 1 ? 'true' : undefined}>
          {c.ribbon.map(([cls, st, txt, note]) => (
            <span><b class:list={{ 'r-live': cls === 'live' }}>{st}</b>&nbsp;&nbsp;<Fragment set:html={txt} />&nbsp;&nbsp;<i>{note}</i></span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <section class="section" id="work">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="display display-zh">{c.mHead}</h2>
        <p>{c.mP}</p>
      </div>
      <div class="fixtures">
        {MATCHES.map((m) => (
          <a class="fixture" href={href(lang, `${m.slug}/`)}>
            <div class="fx-top">
              <span class={`status ${m.status}`}>{m.statusLabel[lang]}</span>
              <span class="mono">{m.dates[lang]}</span>
            </div>
            <div class="fx-main">
              <div>
                <h3 class="fx-title display display-zh">{m.title[lang]}</h3>
                <p class="fx-cat">{m.category[lang]}</p>
              </div>
              <span class:list={['tile', { live: m.status === 'live' }]}><strong>{m.score.value[lang]}</strong><span>{m.score.label[lang]}</span></span>
            </div>
            <div class="fx-bottom">
              <p>{m.line[lang]}</p>
              <span class="fx-go">{c.open} →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="display display-zh">{c.hHead}</h2>
        <p>{c.hP}</p>
      </div>
      <div class="highlights">
        {shots.map((img, i) => (
          <figure>
            <Image src={img} alt={c.caps[i]} widths={i === 0 ? [800, 1200] : [400, 700]} sizes={i === 0 ? '(max-width: 760px) 94vw, 620px' : '(max-width: 760px) 46vw, 300px'} />
            <figcaption>{c.caps[i]}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="player" style="padding-top: 0">
    <div class="wrap player">
      <div>
        <h2 class="display display-zh">{c.pHead}</h2>
        <p class="player-lead">{c.pLead}</p>
      </div>
      <div class="card-stats">
        <div class="cs-head mono"><span>Allen Huang</span><span>#2026</span></div>
        <dl>
          {c.card.map(([k, v]) => <div class="row"><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
      </div>
    </div>
  </section>

  <section class="section contact" id="contact">
    <div class="wrap">
      <div>
        <h2 class="display display-zh">{c.cHead}</h2>
        <p>{c.cP}</p>
      </div>
      <div class="contact-list">
        <a href={`mailto:${CONTACT.email}`}><span>{UI.email[lang]}</span><b>{CONTACT.email}</b></a>
        <a href={CONTACT.linkedin} target="_blank" rel="noreferrer"><span>LinkedIn</span><b>yilun-huang ↗</b></a>
        <a href={CONTACT.github} target="_blank" rel="noreferrer"><span>GitHub</span><b>SeikiChan ↗</b></a>
      </div>
    </div>
  </section>
</Base>
