---
import type { Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;

// One trading day in ai-portfolio-arena (auto_trader.py, engines/, peer_review.py).
const t = {
  en: {
    steps: [
      { time: '10:00 ET', title: 'Freeze the packet', body: 'Prices, quotes, news, financials. One file, one SHA-256.' },
      { time: 'Decide', title: 'Two engines, apart', body: '' },
      { time: 'Referee', title: 'validate()', body: 'Schema, citations, limits. Fail any check and the round is void.' },
      { time: 'Trade', title: 'Paper limit orders', body: 'Day orders to each model’s own Alpaca paper account.' },
      { time: 'After', title: 'Post-match comments', body: 'Each model comments once on the other’s published decision.' },
    ],
    claude: ['Claude', 'own instructions, memory, account'],
    gpt: ['GPT', 'same, plus a research desk that finishes before the decision'],
    cap: 'Every round keeps the packet, the full prompt, the raw reply and the verdict.',
  },
  zh: {
    steps: [
      { time: '美东 10:00', title: '冻结数据包', body: '价格、报价、新闻、财报。一个文件，一个 SHA-256。' },
      { time: '决策', title: '两个引擎，各做各的', body: '' },
      { time: '裁判', title: 'validate()', body: '结构、引文、限额。任何一条不过，整轮作废。' },
      { time: '下单', title: '模拟盘限价单', body: '当日限价单，发到各自的 Alpaca 模拟账户。' },
      { time: '赛后', title: '互评', body: '每个模型给对方公开的决策写一条评论。' },
    ],
    claude: ['Claude', '自己的指令、记忆、账户'],
    gpt: ['GPT', '同上，另有研究台，在决策前完成检索'],
    cap: '每一轮都存档：数据包、完整提示词、原始回复、裁判结论。',
  },
}[lang];
---

<figure class="fig flow">
  <ol>
    {t.steps.map((s, i) => (
      <li class:list={{ split: i === 1, ref: i === 2 }}>
        <span class="mono when">{s.time}</span>
        {i === 1 ? (
          <div class="pair">
            <div class="eng home"><b>{t.claude[0]}</b><span>{t.claude[1]}</span></div>
            <div class="eng away"><b>{t.gpt[0]}</b><span>{t.gpt[1]}</span></div>
          </div>
        ) : (
          <div><b class:list={{ code: i === 2 }}>{s.title}</b><span>{s.body}</span></div>
        )}
      </li>
    ))}
  </ol>
  <figcaption>{t.cap}</figcaption>
</figure>

<style>
  ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0; }
  li { padding: 14px 16px 16px; border-left: 2px solid var(--ink); display: grid; gap: 10px; align-content: start; position: relative; }
  li:first-child { border-left: 0; padding-left: 0; }
  li::after { content: '→'; position: absolute; right: -9px; top: 12px; background: var(--card); color: var(--ink); font-weight: 700; line-height: 1; padding: 2px 0; }
  li:last-child::after { display: none; }
  .when { color: var(--away); }
  li b { display: block; font-size: 1.05rem; font-weight: 600; margin-bottom: 4px; }
  li b.code { font-family: var(--mono); }
  li span:not(.when) { font-size: 14px; color: var(--ink-2); line-height: 1.5; }
  li.ref { background: var(--board); color: var(--board-ink); }
  li.ref span:not(.when) { color: var(--board-muted); }
  li.ref .when { color: #9fb3ff; }
  .pair { display: grid; gap: 8px; }
  .eng { border: 2px solid currentColor; padding: 8px 10px; }
  .eng.home { color: var(--home); }
  .eng.away { color: var(--away); }
  .eng b { margin: 0; }
  .eng span { color: var(--ink-2) !important; font-size: 13px !important; }
  @media (max-width: 900px) {
    ol { grid-template-columns: 1fr; }
    li, li:first-child { border-left: 0; border-top: 2px solid var(--ink); padding: 14px 0; }
    li:first-child { border-top: 0; padding-top: 0; }
    li.ref { padding: 14px; }
    li::after { display: none; }
  }
</style>
