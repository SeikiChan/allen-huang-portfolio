---
import type { Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;

// From the module docstring of am7030_basis.py (private repository). No money amounts or returns are shown.
const cards = {
  en: [
    {
      tag: 'Wrong unit',
      before: 'A liquidity floor was calibrated on consolidated volume, but live data comes from the IEX feed, which reports only about 1.5–2% of it. The same threshold admitted ~131 of 540 names instead of ~513 of 516 — silently shrinking the universe.',
      after: 'Eligibility is a cross-sectional rank. A rank has no unit, so it cannot break when the data feed changes.',
    },
    {
      tag: 'Wrong window',
      before: '12-1 momentum needs 252 sessions of history, so the first year of the cache was mostly cash. Statistics quoted over the full cache mixed that warm-up year into the result.',
      after: 'The first valid signal date is derived from the data, and the stats function refuses a contaminated window unless the caller asks for it explicitly.',
    },
  ],
  zh: [
    {
      tag: '单位错了',
      before: '流动性门槛是按全市场合并成交量校准的，但实盘数据来自 IEX 单一场所，只有合并成交量的约 1.5–2%。同一个阈值只放进了 540 只中的约 131 只，而不是 516 只中的约 513 只，股票池被悄悄缩小。',
      after: '改用横截面排名作为准入条件。排名没有单位，换数据源也不会失效。',
    },
    {
      tag: '区间错了',
      before: '12-1 动量需要 252 个交易日的历史，所以缓存的第一年基本是现金。按全部缓存区间计算的统计，把这一年的预热期混进了结果。',
      after: '第一个有效信号日由数据推导；统计函数拒绝计算被污染的区间，除非调用方明确要求。',
    },
  ],
}[lang];
const l = lang === 'en' ? { before: 'Before', after: 'After' } : { before: '之前', after: '之后' };
---

<div class="basis">
  {cards.map((c) => (
    <figure class="fig">
      <p class="mono tag">{c.tag}</p>
      <p class="mono lbl">{l.before}</p>
      <p>{c.before}</p>
      <p class="mono lbl after">{l.after}</p>
      <p>{c.after}</p>
    </figure>
  ))}
</div>

<style>
  .basis { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .basis p { font-size: 15px; color: var(--ink-2); }
  .tag { color: var(--cobalt) !important; font-weight: 500; margin-bottom: 14px; }
  .lbl { color: var(--muted) !important; margin-bottom: 4px; }
  .lbl.after { border-top: 1px dashed var(--line); padding-top: 12px; margin-top: 4px; color: var(--ink) !important; }
  @media (max-width: 760px) { .basis { grid-template-columns: 1fr; } }
</style>
