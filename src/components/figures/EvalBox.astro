---
import type { Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;

// Per-category pairwise outcomes, counted from docs/portfolio_case_study_25_cases.md (narrow wins count as wins).
const rows: [string, string, number, number, number][] = [
  ['Instruction following', '指令遵循', 4, 1, 3],
  ['Multilingual', '多语言', 2, 1, 2],
  ['Grounding in given facts', '依据给定事实', 3, 1, 1],
  ['Context & ambiguity', '上下文与歧义', 2, 1, 2],
  ['Safety boundaries', '安全边界', 2, 0, 0],
];
const total = rows.reduce((a, r) => [a[0] + r[2], a[1] + r[3], a[2] + r[4]], [0, 0, 0]);
const h = lang === 'en' ? ['Category', 'Cases', 'GPT', 'Claude', 'Draw', ''] : ['类别', '题数', 'GPT', 'Claude', '平', ''];
---

<figure class="fig">
  <div class="table-wrap">
    <table class="data box">
      <thead><tr>{h.map((x, i) => <th class:list={{ num: i > 0 && i < 5 }}>{x}</th>)}</tr></thead>
      <tbody>
        {rows.map(([en, zh, g, c, d]) => (
          <tr>
            <td>{lang === 'en' ? en : zh}</td>
            <td class="num">{g + c + d}</td>
            <td class="num g">{g}</td>
            <td class="num c">{c}</td>
            <td class="num">{d}</td>
            <td class="bar-cell" aria-hidden="true">
              <span class="bar">{Array.from({ length: g }).map(() => <i class="g" />)}{Array.from({ length: d }).map(() => <i class="d" />)}{Array.from({ length: c }).map(() => <i class="c" />)}</span>
            </td>
          </tr>
        ))}
      </tbody>
      <tfoot>
        <tr><td>{lang === 'en' ? 'Total' : '合计'}</td><td class="num">25</td><td class="num g">{total[0]}</td><td class="num c">{total[1]}</td><td class="num">{total[2]}</td><td /></tr>
      </tfoot>
    </table>
  </div>
</figure>

<style>
  .box td.g { color: var(--home); font-weight: 600; }
  .box td.c { color: var(--away); font-weight: 600; }
  .box tfoot td { border-top: 2px solid var(--ink); border-bottom: 0; font-weight: 600; font-family: var(--display); font-size: 1.6rem; padding-top: 12px; }
  .box tfoot td:first-child { font-family: var(--sans); font-size: 15px; }
  .bar-cell { width: 42%; }
  .bar { display: flex; gap: 3px; }
  .bar i { width: 26px; height: 18px; display: block; }
  .bar i.g { background: var(--home); }
  .bar i.c { background: var(--away); }
  .bar i.d { background: transparent; border: 1.5px solid var(--tie); }
</style>
