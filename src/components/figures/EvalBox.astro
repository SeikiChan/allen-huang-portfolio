---
import type { Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;

// Per-category pairwise outcomes, counted from docs/portfolio_case_study_25_cases.md (narrow wins count as wins).
const rows: [string, string, number, number, number][] = [
  ['Instruction following', '指令遵循', 4, 1, 3],
  ['Multilingual', '多语言', 2, 1, 2],
  ['Grounded answers', '依据事实', 3, 1, 1],
  ['Context & ambiguity', '上下文与歧义', 2, 1, 2],
  ['Safety', '安全边界', 2, 0, 0],
];
const t = lang === 'en'
  ? { head: 'Results by category', n: 'cases', gpt: 'GPT wins', claude: 'Claude wins', draw: 'Draw', total: 'Total' }
  : { head: '分类结果', n: '题', gpt: 'GPT 胜', claude: 'Claude 胜', draw: '平局', total: '合计' };
---

<figure class="fig box">
  <div class="fig-head"><span>{t.head}</span><span class="legend"><i class="g"></i>{t.gpt}<i class="c"></i>{t.claude}<i class="d"></i>{t.draw}</span></div>
  <ul>
    {rows.map(([en, zh, g, c, d]) => (
      <li>
        <span class="name">{lang === 'en' ? en : zh}<small>{g + c + d} {t.n}</small></span>
        <span class="bar" aria-hidden="true">
          {Array.from({ length: g }).map(() => <i class="g" />)}{Array.from({ length: c }).map(() => <i class="c" />)}{Array.from({ length: d }).map(() => <i class="d" />)}
        </span>
        <span class="nums"><b class="g">{g}</b><b class="c">{c}</b><b>{d}</b></span>
      </li>
    ))}
  </ul>
  <div class="total"><span>{t.total} · 25 {t.n}</span><strong><b class="g">13</b> : <b class="c">4</b><small>{lang === 'en' ? ' · 8 draws' : ' · 8 平'}</small></strong></div>
</figure>

<style>
  .box { display: grid; gap: 4px; }
  .fig-head { align-items: center; }
  .legend { display: inline-flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .legend i { width: 10px; height: 10px; border-radius: 3px; margin-left: 8px; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: minmax(7.5em, 0.9fr) minmax(0, 1.4fr) auto; align-items: center; gap: 14px; padding: 12px 0; border-top: 1px solid var(--line); }
  .name { font-size: 14.5px; font-weight: 500; white-space: nowrap; display: grid; }
  .name small { font-size: 12px; color: var(--muted); font-weight: 400; }
  .bar { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 3px; }
  .bar i, .legend i { display: block; height: 14px; border-radius: 3px; }
  .bar i.g, .legend i.g { background: var(--home); }
  .bar i.c, .legend i.c { background: var(--away); }
  .bar i.d, .legend i.d { background: transparent; box-shadow: inset 0 0 0 1.5px var(--tie); }
  .nums { display: grid; grid-template-columns: repeat(3, 1.6em); text-align: center; font-variant-numeric: tabular-nums; font-size: 14px; }
  .nums b { font-weight: 500; color: var(--muted); }
  b.g { color: var(--home); font-weight: 700; }
  b.c { color: var(--away); font-weight: 700; }
  .total { display: flex; justify-content: space-between; align-items: baseline; border-top: 1.5px solid var(--ink); padding-top: 12px; margin-top: 2px; font-size: 14px; color: var(--muted); }
  .total strong { font-size: 1.9rem; letter-spacing: -0.03em; color: var(--ink); font-variant-numeric: tabular-nums; }
  .total small { font-size: 14px; color: var(--muted); font-weight: 400; letter-spacing: 0; }
  @media (max-width: 420px) { li { grid-template-columns: 1fr auto; } .bar { grid-column: 1 / -1; grid-row: 2; } }
</style>
