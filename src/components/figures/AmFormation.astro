---
import type { Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;

// AM 70/30 construction as documented in alpaca-live-trading (PROJECT_STATUS.md, ADR-003). Parameters only; no returns.
const t = {
  en: {
    pool: ['Stock pool', 'US stocks that pass a liquidity screen. The screen is a cross-sectional rank, so it has no units to get wrong.'],
    score: 'Score',
    mom: ['12-1 momentum', 'return over the past 12 months, skipping the latest month'],
    pull: ['5-day pullback', 'a short dip inside the trend'],
    core: ['Core sleeve', 'Top 20 by score'],
    rank: ['Rank sleeve', '0.80 × score + 0.20 × rank acceleration, top 20'],
    week: ['Every week', 'Rebalance once. A held stock keeps its place until it drops 7 ranks past the cut. Minimum holding period. A stock down 20% from entry is cut in half.'],
    day: ['Other days', 'Risk check only: sells allowed, no buys.'],
    gates: ['Two gates', 'SPY below its 250-day average → move to cash. Account drawdown past −18% → exposure cut to 25%.'],
    now: ['Since 2026-09-29', 'PM20: pure 12-1 momentum, top 20. No pullback leg, no forced hold, no stop. It replaced the full formation after the rule-by-rule test.'],
  },
  zh: {
    pool: ['股票池', '通过流动性筛选的美股。筛选用横截面排名，排名没有单位，也就不会用错单位。'],
    score: '打分',
    mom: ['12-1 动量', '过去 12 个月的涨幅，跳过最近 1 个月'],
    pull: ['5 日回调', '趋势中的短暂回落'],
    core: ['核心组', '按分数取前 20'],
    rank: ['排名组', '0.80 × 分数 + 0.20 × 排名加速度，取前 20'],
    week: ['每周', '调仓一次。持仓要掉出前 20 之后再多掉 7 名才卖。有最短持有期。比买入价跌 20% 的股票砍一半。'],
    day: ['其他日子', '只做风险检查：只许卖，不许买。'],
    gates: ['两道闸', 'SPY 跌破 250 日均线 → 转现金。账户回撤超过 −18% → 仓位降到 25%。'],
    now: ['2026-09-29 起', 'PM20：纯 12-1 动量，取前 20。去掉回调腿、强制持有和止损。一条一条拆规则之后，它替换了原来的整套阵型。'],
  },
}[lang];
---

<figure class="fig formation">
  <div class="pool"><span class="mono">{t.pool[0]}</span><p>{t.pool[1]}</p></div>
  <div class="score">
    <span class="mono">{t.score}</span>
    <div class="eq">
      <span class="w">0.70</span><span class="x">×</span><span class="f"><b>{t.mom[0]}</b><small>{t.mom[1]}</small></span>
      <span class="plus">+</span>
      <span class="w">0.30</span><span class="x">×</span><span class="f"><b>{t.pull[0]}</b><small>{t.pull[1]}</small></span>
    </div>
  </div>
  <div class="split" role="img" aria-label="70% core sleeve, 30% rank sleeve">
    <div class="s70"><strong>70%</strong><b>{t.core[0]}</b><span>{t.core[1]}</span></div>
    <div class="s30"><strong>30%</strong><b>{t.rank[0]}</b><span>{t.rank[1]}</span></div>
  </div>
  <div class="rows">
    {[t.week, t.day, t.gates].map(([k, v]) => <div><span class="mono">{k}</span><p>{v}</p></div>)}
  </div>
  <div class="now"><span class="mono">{t.now[0]}</span><p>{t.now[1]}</p></div>
</figure>

<style>
  .formation { display: grid; gap: 0; padding: 0; }
  .formation > div { padding: 16px clamp(14px, 2.4vw, 24px); border-top: 2px solid var(--ink); }
  .formation > div:first-child { border-top: 0; }
  .mono { color: var(--muted); display: block; margin-bottom: 6px; }
  p { color: var(--ink-2); font-size: 15px; }
  .eq { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; }
  .w { font-family: var(--display); font-weight: 900; font-size: 2.6rem; line-height: 1; color: var(--ink); }
  .x, .plus { font-size: 1.4rem; color: var(--muted); }
  .plus { margin: 0 6px; }
  .f { display: grid; }
  .f b { font-size: 1.05rem; }
  .f small { color: var(--muted); font-size: 13px; }
  .split { display: grid; grid-template-columns: 7fr 3fr; padding: 0 !important; }
  .split > div { padding: 18px clamp(14px, 2.4vw, 24px); display: grid; gap: 2px; color: #fff; }
  .s70 { background: var(--home); }
  .s30 { background: var(--away); }
  .split strong { font-family: var(--display); font-weight: 900; font-size: clamp(2.4rem, 5vw, 3.6rem); line-height: 0.95; }
  .split span { font-size: 14px; opacity: 0.86; }
  .rows { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px 28px; }
  .now { background: var(--board); color: var(--board-ink); }
  .now .mono { color: #9fb3ff; }
  .now p { color: var(--board-ink); }
  @media (max-width: 760px) {
    .rows { grid-template-columns: 1fr; }
    .split { grid-template-columns: 1fr; }
  }
</style>
